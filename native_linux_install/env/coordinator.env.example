# Coordinator sunucusunda bu dosyayi kopyalayip gercek degerleri doldur.
# Ornek: cp coordinator.env.example /tmp/trino-coordinator.env

TRINO_ENVIRONMENT=prod

# Buraya coordinator'in worker'lar tarafindan erisilebilir DNS/IP adresini yaz.
# Ornek: http://trino-coordinator.company.local:8080
TRINO_COORDINATOR_URI=http://<coordinator-host>:8080

# PostgreSQL kullanilmayacaksa yine placeholder kalabilir ama catalog dosyasini
# kaldirmak daha temiz olur.
POSTGRESQL_HOST=<postgres-host>
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=<database-name>
POSTGRESQL_USER=<trino-readonly-user>
POSTGRESQL_PASSWORD=<password>

# Oracle icin DBA'den host, port ve service name bilgisini al.
# SID kullaniliyorsa oracle.properties dosyasindaki JDBC URL formatini degistir.
ORACLE_HOST=<oracle-host>
ORACLE_PORT=1521
ORACLE_SERVICE=<oracle-service-name>
ORACLE_USER=<trino-readonly-user>
ORACLE_PASSWORD=<password>

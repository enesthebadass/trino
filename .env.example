TRINO_VERSION=470
TRINO_ENVIRONMENT=prod
TRINO_COORDINATOR_HOSTNAME=trino-coordinator
TRINO_COORDINATOR_URI=http://trino-coordinator:8080
TRINO_NODE_ID=trino-worker-01
TRINO_HTTP_PORT=8080
TRINO_HTTPS_PORT=8443
TRINO_INTERNAL_HTTP_PORT=8080

POSTGRESQL_HOST=postgres.example.internal
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=analytics
POSTGRESQL_USER=trino
POSTGRESQL_PASSWORD=change-me

ORACLE_HOST=oracle.example.internal
ORACLE_PORT=1521
ORACLE_SERVICE=ORCLPDB1
ORACLE_USER=trino
ORACLE_PASSWORD=change-me

# Required only when HTTPS is enabled.
TRINO_KEYSTORE_PASSWORD=change-me
